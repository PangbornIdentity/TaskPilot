<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – TaskPilot</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="tp-auth-body">
    <div class="tp-auth-container">
        <div class="tp-auth-brand">
            <img src="/img/taskpilot-logo.png" alt="TaskPilot" width="72" height="72" class="tp-auth-logo" decoding="async" />
            <h1 class="tp-auth-title">TaskPilot</h1>
            <p class="tp-auth-subtitle">Your tasks, on autopilot</p>
        </div>
        <div class="tp-auth-card card shadow-sm">
            <div class="card-body p-4">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
