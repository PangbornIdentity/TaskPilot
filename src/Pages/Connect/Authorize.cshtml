@page
@model TaskPilot.Pages.Connect.AuthorizeModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Authorize";
}

<div class="tp-auth-card">
    <div class="tp-auth-header text-center mb-4">
        <img src="/img/taskpilot-logo.png" alt="TaskPilot" class="tp-auth-logo mb-3" width="72" height="72" />
        <h1 class="tp-auth-title">Authorize Access</h1>
        <p class="tp-text-muted">
            <strong>@Model.ClientName</strong> is requesting access to your TaskPilot tasks.
        </p>
    </div>

    <div class="mb-3">
        <h6 class="fw-semibold mb-2">This will allow the app to:</h6>
        <ul class="list-unstyled">
            <li class="d-flex align-items-start gap-2 mb-1">
                <i class="bi bi-check-circle-fill text-success mt-1" aria-hidden="true"></i>
                <span>Read, create, update, and delete your tasks via MCP</span>
            </li>
            <li class="d-flex align-items-start gap-2 mb-1">
                <i class="bi bi-check-circle-fill text-success mt-1" aria-hidden="true"></i>
                <span>Access task statistics and tags</span>
            </li>
        </ul>
    </div>

    <div class="d-flex gap-2">
        <form method="post" asp-page="/Connect/Authorize" class="flex-grow-1">
            @Html.AntiForgeryToken()
            <input type="hidden" name="consent" value="granted" />
            @foreach (var param in Model.OAuthParameters)
            {
                <input type="hidden" name="@param.Key" value="@param.Value" />
            }
            <button type="submit" class="btn btn-primary w-100">Allow Access</button>
        </form>
        <form method="post" asp-page="/Connect/Authorize" class="flex-grow-1">
            @Html.AntiForgeryToken()
            <input type="hidden" name="consent" value="denied" />
            @foreach (var param in Model.OAuthParameters)
            {
                <input type="hidden" name="@param.Key" value="@param.Value" />
            }
            <button type="submit" class="btn btn-outline-secondary w-100">Deny</button>
        </form>
    </div>
</div>
